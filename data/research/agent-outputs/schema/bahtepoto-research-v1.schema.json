{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bahtepoto.com/schema/bahtepoto-research-v1.schema.json",
  "title": "BAHTEPOTO Kronik Araştırma JSON v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent", "brands", "models", "researchedAt", "sources", "issues"],
  "properties": {
    "schema": { "const": "bahtepoto-research-v1" },
    "agent": { "type": "string", "minLength": 1 },
    "brands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "models": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "researchedAt": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "kind", "reviewed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "kind": {
          "enum": ["manufacturer-bulletin", "official-recall", "technical-publication", "reliability-survey", "expert-service", "user-report"]
        },
        "publisher": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date" },
        "reviewed": { "type": "boolean", "description": "Metin gerçekten okunduysa true. Arama sonucunda bağlantı görmek yeterli değildir." },
        "reviewMethod": { "type": "string" },
        "note": { "type": "string" },
        "basedOn": { "type": "string", "description": "Aynı haberin kopyaları aynı değeri taşır." }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Katalogdaki motor adı veya aile adı. Dahili motor kimliği yazılmaz." },
        "code": { "type": "string" }
      },
      "anyOf": [{ "required": ["name"] }, { "required": ["code"] }]
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model"],
      "properties": {
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "generation": { "type": "string" },
        "engines": { "type": "array", "items": { "$ref": "#/$defs/engine" } },
        "years": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "integer" },
            "to": { "type": "integer" }
          }
        },
        "transmission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["manual", "automatic", "dual-clutch", "cvt", "single-speed", "automated-manual"] },
            "name": { "type": "string" }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "category", "frequency", "frequencyRationale", "vehicles", "sourceIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "minLength": 20, "maxLength": 280 },
        "category": {
          "enum": ["engine", "fuel-system", "cooling", "emissions", "transmission", "clutch", "electrical", "suspension", "steering", "brakes", "body", "interior", "hvac", "other"]
        },
        "frequency": { "enum": ["high", "medium", "low", "unknown"] },
        "frequencyRationale": { "type": "string", "minLength": 10 },
        "vehicles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vehicle" } },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "uncertainties": { "type": "string" },
        "example": { "type": "boolean" }
      }
    }
  }
}

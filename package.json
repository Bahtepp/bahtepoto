{
  "name": "bahtepoto.com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "bahtepoto.com web sitesi (Astro + TypeScript, statik site)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {

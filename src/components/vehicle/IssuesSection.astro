---
/**
 * Kronik ve bilinen sorunlar, ardından resmî geri çağırmalar.
 * Kayıt yoksa "sorun yok" denmez.
 */
import IssueItem from './IssueItem.astro';
import type { DisplayGroups } from '@/lib/issues/match';

interface Props {
  groups: DisplayGroups;
  engineMappingUncertain?: boolean;
  headingId?: string;
}

const { groups, engineMappingUncertain = false, headingId = 'kronik-sorunlar' } = Astro.props;

const SECTIONS = [
  {
    key: 'known' as const,
    id: `${headingId}-bilinen`,
    title: '',
    empty: 'Bu araç için derlenmiş bilinen sorun kaydı henüz yok. Bu, aracın sorunsuz olduğu anlamına gelmez.',
  },
  {
    key: 'possible' as const,
    id: `${headingId}-olasi`,
    title: 'Bildirilmiş olası sorunlar',
    empty: undefined,
  },
  {
    key: 'recalls' as const,
    id: `${headingId}-geri-cagirma`,
    title: 'Resmî geri çağırmalar',
    empty: 'Bu araç seçimiyle eşleşen geri çağırma kaydı veritabanımızda yok. Bu, aracınız için geri çağırma olmadığı anlamına gelmez.',
  },
];
---

<section class="issues-section" aria-labelledby={headingId}>
  <h2 id={headingId}>Kronik ve bilinen sorunlar</h2>

  {
    engineMappingUncertain && (
      <p class="callout-warn">
        Bu motorun seçilen makyaj döneminde sunulduğu henüz doğrulanmadı. Motora özgü kayıtlar bu yüzden koşullu
        eşleşme olarak gösterilir.
      </p>
    )
  }

  {
    SECTIONS.filter((s) => s.key !== 'possible' || groups.possible.length > 0).map((s) => (
      <section class="issue-kind" aria-labelledby={s.title ? s.id : undefined}>
        {s.title && (
          <h3 id={s.id} class="issue-kind-title">
            {s.title} {groups[s.key].length > 0 && <span class="count">{groups[s.key].length}</span>}
          </h3>
        )}
        {s.key === 'recalls' && (
          <p class="callout-info">
            Geri çağırma belirli bir üretim aralığındaki bazı araçları kapsar. Aracınızın kapsamda olup olmadığı şasi
            numarasıyla resmi sorguda kesinleşir.
          </p>
        )}
        {groups[s.key].length === 0 && s.empty && !(s.key === 'known' && groups.possible.length > 0) ? (
          <div class="issues-empty">
            <p>{s.empty}</p>
          </div>
        ) : (
          <ul class="issue-list">
            {groups[s.key].map(({ issue, match, scope }) => (
              <IssueItem issue={issue} match={match} scope={scope} anchorPrefix={s.id} />
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <p class="issue-disclaimer">
    Bu bilgiler kullanıcı deneyimleri ve erişilebilir teknik kaynaklardan derlenmiştir. Her araçta görülmeyebilir; kesin
    arıza teşhisi veya ekspertiz yerine geçmez.
  </p>
</section>

---
/**
 * Bir araç için sorun kayıtları. Üç kategori AYRI bölümlerde gösterilir ve birbirine karışmaz:
 *   1. Kronik sorunlar / tekrarlayan problemler
 *   2. Bilinen kusurlar
 *   3. Resmi geri çağırmalar ve servis kampanyaları
 * Kayıt yoksa "sorun yok" DEMEZ; verinin henüz bulunmadığını söyler.
 */
import IssueGroups from './IssueGroups.astro';
import type { GroupedIssues, IssuesByKind } from '@/lib/issues/match';
import type { IssueSource } from '@/lib/issues/schema';

interface Props {
  groups: IssuesByKind;
  sourceById: Map<string, IssueSource>;
  label: (id: string) => string;
  engineName: string;
  generationName: string;
  /** Motor-makyaj dönemi eşleşmesi doğrulanmadıysa uyarı gösterilir. */
  engineMappingUncertain?: boolean;
  headingId?: string;
}

const { groups, sourceById, label, engineName, generationName, engineMappingUncertain = false, headingId = 'kronik-sorunlar' } =
  Astro.props;

const count = (g: GroupedIssues) => g.engine.length + g.general.length + g.conditional.length + g.researching.length;
const confirmed = (g: GroupedIssues) => g.engine.length + g.general.length;
const common = { sourceById, label, engineName, generationName };
---

<section class="issues-section" aria-labelledby={headingId}>
  <h2 id={headingId}>Kronik sorunlar, bilinen kusurlar ve geri çağırmalar</h2>

  {
    engineMappingUncertain && (
      <p class="callout-warn">
        Bu motorun seçilen makyaj döneminde sunulduğu henüz doğrulanmadı. Bu yüzden motora özgü kayıtlar kesin olarak
        eşleştirilmez ve "Koşullu eşleşmeler" altında gösterilir. Kasa ve model genelindeki kayıtlar etkilenmez.
      </p>
    )
  }

  <section class="issue-kind" aria-labelledby={`${headingId}-kronik`}>
    <h3 id={`${headingId}-kronik`} class="issue-kind-title">Kronik sorunlar ve tekrarlayan problemler</h3>
    <p class="issue-kind-help">
      Tekrarladığına dair kaynak bulunan sorunlar. Görülme sıklığı kanıtı her kayıtta ayrıca belirtilir; model düzeyindeki
      istatistikler belirli bir motorun arıza oranı değildir.
    </p>
    {
      confirmed(groups.chronic) === 0 && (
        <div class="issues-empty">
          <p class="issues-empty-title">Henüz doğrulanmış kronik sorun verisi bulunmuyor.</p>
          <p>Bu, aracın kronik sorunu olmadığı anlamına gelmez.{count(groups.chronic) > 0 && ' Aşağıdaki kayıtlar yalnızca koşullu veya araştırılıyor durumunda.'}</p>
        </div>
      )
    }
    <IssueGroups groups={groups.chronic} anchorPrefix={`${headingId}-k`} {...common} />
  </section>

  <section class="issue-kind" aria-labelledby={`${headingId}-kusur`}>
    <h3 id={`${headingId}-kusur`} class="issue-kind-title">Bilinen kusurlar</h3>
    <p class="issue-kind-help">Kaynakla belgelenmiş, ancak tekrarlama kanıtı kronik sorun düzeyine ulaşmamış kayıtlar.</p>
    {
      count(groups.defects) === 0 && (
        <div class="issues-empty">
          <p>Bu araç için eşleşen bilinen kusur kaydı henüz bulunmuyor.</p>
        </div>
      )
    }
    <IssueGroups groups={groups.defects} anchorPrefix={`${headingId}-b`} {...common} />
  </section>

  <section class="issue-kind" aria-labelledby={`${headingId}-geri-cagirma`}>
    <h3 id={`${headingId}-geri-cagirma`} class="issue-kind-title">Resmi geri çağırmalar ve servis kampanyaları</h3>
    <p class="callout-info">
      Geri çağırma, belirli bir üretim aralığındaki <strong>bazı</strong> araçları kapsar; tek başına yaygın bir kronik
      arıza anlamına gelmez. Yayımlanmış şasi numarası (VIN) aralığı olmadığı için bir kampanyanın sizin aracınızı kapsayıp
      kapsamadığı ve onarımın yapılıp yapılmadığı ancak <strong>şasi numarasıyla resmi sorgu</strong> sonucunda kesinleşir:
      Ford yetkili servisine ya da aracın tescil edildiği ülkenin resmi geri çağırma sorgulama hizmetine başvurun.
    </p>
    {
      count(groups.recalls) === 0 && (
        <div class="issues-empty">
          <p>
            Bu araç seçimiyle eşleşen geri çağırma kaydı veritabanımızda yok. Bu, aracınız için geri çağırma olmadığı
            anlamına gelmez.
          </p>
        </div>
      )
    }
    <IssueGroups groups={groups.recalls} anchorPrefix={`${headingId}-g`} flat {...common} />
  </section>
</section>

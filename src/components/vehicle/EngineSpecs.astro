---
/**
 * Motor özellikleri — yalnızca katalogdaki kaynaklı veriden. Eksik alan "Veri doğrulanıyor".
 */
import type { Engine, Variant } from '@/lib/catalog/schema';
import { FUEL_LABELS, PENDING_TEXT, formatDisplacement, formatPower, formatTransmission } from '@/lib/catalog/format';
import { availabilityFor, formatModelYears, performanceBadge } from '@/lib/catalog/market';

interface Props {
  engine: Engine;
  variant: Variant;
}

const { engine, variant } = Astro.props;
const badge = performanceBadge(variant);
const drivetrain = variant.drivetrain ? { fwd: 'Önden çekiş', rwd: 'Arkadan itiş', awd: 'Dört çeker' }[variant.drivetrain] : undefined;

const tr = availabilityFor(variant, 'tr');
const rows: [string, string | string[] | undefined | null][] = [
  ['Yakıt', engine.fuel ? FUEL_LABELS[engine.fuel] : null],
  ['Güç', formatPower(engine.power)],
  ['Tork', engine.torqueNm ? `${engine.torqueNm} Nm` : null],
  ['Hacim', formatDisplacement(engine) ?? (engine.fuel === 'electric' ? '—' : null)],
  ['Motor kodu', engine.codes.length ? engine.codes.join(', ') : null],
  ['Şanzıman', variant.transmissions.length ? variant.transmissions.map((t) => formatTransmission(t)) : null],
  ['Çekiş', drivetrain],
  ['Batarya', engine.batteryKwh ? `${engine.batteryKwh.toLocaleString('tr-TR')} kWh` : undefined],
  ['Model yılları', tr?.modelYears.length ? formatModelYears(tr.modelYears) : null],
  ['Gövde', tr?.bodyTypes.length ? tr.bodyTypes.join(', ') : null],
];
// `undefined`: alan bu motor için anlamsız (gösterilmez). `null`: veri yok (Veri doğrulanıyor).
const visible = rows.filter(([, v]) => v !== undefined);
---

<section class="vehicle-section" aria-labelledby="motor">
  <h2 id="motor">Motor özellikleri</h2>
  {badge && (
    <p class="section-meta">
      <span class="badge badge-trim">{badge}</span>
    </p>
  )}
  <dl class="spec-grid">
    {
      visible.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>
            {v === null ? (
              <span class="pending">{PENDING_TEXT}</span>
            ) : Array.isArray(v) ? (
              <ul class="plain">
                {v.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            ) : (
              v
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

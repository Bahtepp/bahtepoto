---
/**
 * Tek bir kategori (kronik / bilinen kusur / geri çağırma) içindeki eşleşme grupları:
 * motora özgü, kasa ve model geneli, koşullu, araştırılan/tartışmalı.
 */
import IssueItem from './IssueItem.astro';
import type { GroupedIssues } from '@/lib/issues/match';
import type { IssueSource } from '@/lib/issues/schema';

interface Props {
  groups: GroupedIssues;
  sourceById: Map<string, IssueSource>;
  label: (id: string) => string;
  engineName: string;
  generationName: string;
  anchorPrefix: string;
  /** Geri çağırmalarda "kesin/koşullu" yerine tek liste ve kapsam koşulları gösterilir. */
  flat?: boolean;
}

const { groups, sourceById, label, engineName, generationName, anchorPrefix, flat = false } = Astro.props;

const sections = flat
  ? [{ key: 'all', title: undefined, help: undefined, items: [...groups.engine, ...groups.general, ...groups.conditional, ...groups.researching] }]
  : [
      { key: 'engine', title: `${engineName} motoruna özgü`, help: undefined, items: groups.engine },
      { key: 'general', title: `${generationName} kasası ve model geneli`, help: 'Motor seçiminden bağımsız olarak bu aracı etkileyen kayıtlar.', items: groups.general },
      {
        key: 'conditional',
        title: 'Koşullu eşleşmeler',
        help: 'Yalnızca belirli koşullarda (yıl, pazar, şanzıman, motor türü veya doğrulanmamış motor-dönem eşleşmesi) geçerli; her kaydın koşulu ayrıca yazılıdır.',
        items: groups.conditional,
      },
      {
        key: 'researching',
        title: 'Araştırılan veya tartışmalı kayıtlar',
        help: 'Kesinleşmiş sorun değildir: yalnızca kullanıcı raporlarına dayanıyor ya da kaynaklar çelişiyor.',
        items: groups.researching,
      },
    ];
---

{
  sections
    .filter((s) => s.items.length > 0)
    .map((s) => (
      <div class={`issue-group${s.key === 'researching' ? ' issue-group-muted' : ''}`}>
        {s.title && (
          <h4 class="issue-group-title">
            {s.title} <span class="count">{s.items.length}</span>
          </h4>
        )}
        {s.help && <p class="issue-group-help">{s.help}</p>}
        <ul class="issue-list">
          {s.items.map(({ issue, match }) => (
            <IssueItem issue={issue} match={match} sourceById={sourceById} label={label} anchorPrefix={anchorPrefix} level={flat ? 4 : 5} />
          ))}
        </ul>
      </div>
    ))
}

---
/**
 * Site başlığı ve alt bilgisiyle sayfa iskeleti. İçerik sayfaları bunu kullanır.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={import.meta.env.BASE_URL} class="logo" aria-label={`${SITE.name} ana sayfa`}>BAHTEPOTO</a>
    </div>
  </header>

  <main id="main" class="wrap">
    <slot />
  </main>

  <footer class="wrap site-footer">
    <p>
      Türkiye’de kullanılan otomobillerin marka, model, motor ve kasa seçimi. Kasa yıllarının bir bölümü İngilizce Wikipedia maddelerindeki olgulardan derlendi (CC BY-SA 4.0).
    </p>
  </footer>
</BaseLayout>

<style is:global>
  .wrap {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-h);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo {
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text);
    text-decoration: none;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--warn);
    background: var(--warn-soft);
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
  }

  .site-footer {
    padding-top: 2rem;
    padding-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .site-footer p {
    max-width: 60rem;
    margin: 0;
  }
</style>

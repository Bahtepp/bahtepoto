---
/**
 * Araç detay sayfası: /arac/<marka>/<model>/<nesil>/[<makyaj-dönemi>/]<varyant>/
 *
 * Bölümler modülerdir (`SECTIONS`); ileride yakıt tüketimi, ikinci el kontrol rehberi,
 * bakım maliyetleri ve kullanıcı deneyimleri gibi bölümler yeni bir bileşen ve bir satırla eklenir.
 * Kronik sorunlar yalnızca CANLI veri kümesinden gelir; örnek veri bu sayfalara yüklenmez.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import EngineSpecs from '@/components/vehicle/EngineSpecs.astro';
import IssuesSection from '@/components/vehicle/IssuesSection.astro';
import {
  catalogPath,
  formatYearRange,
  generationLabel,
  vehiclePath,
  withBase,
} from '@/lib/catalog/format';
import { isTurkeyPrimary, performanceBadge } from '@/lib/catalog/market';
import { engineGroupIdentity } from '@/lib/catalog/selector';
import { getIssueData } from '@/lib/issues';
import { groupForDisplay } from '@/lib/issues/match';
import '@/styles/vehicle.css';
import { getCatalog } from '@/lib/catalog';
import { brandTier, isHiddenModel } from '@/lib/catalog/visibility';
import { getCatalogRedirects, getLabeler, getVehicleSelections, isPublicSelection, revisionsForVariant, toVehicleContext, type VehicleSelection } from '@/lib/vehicle';

export async function getStaticPaths() {
  const selections = (await getVehicleSelections()).filter((sel) => isPublicSelection(sel));
  const redirects = await getCatalogRedirects();
  return [
    ...selections.map((sel) => ({
      params: {
        vehicle: vehiclePath({
          brand: sel.brand.slug,
          model: sel.model.slug,
          generation: sel.generation.slug,
          revision: sel.revision?.slug,
          variant: sel.variant.slug,
        }).replace(/^\/arac\/|\/$/g, ''),
      },
      props: { sel },
    })),
    ...redirects.map((r) => ({
      params: { vehicle: r.param },
      props: { redirectTo: r.to },
    })),
  ];
}

interface Props {
  sel?: VehicleSelection;
  redirectTo?: string;
}

const { sel, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo);
if (!sel) throw new Error('Araç sayfası verisi yok');
const { brand, model, generation, revision, variant, engine, revisionMappingVerified } = sel;
const catalog = await getCatalog();
const label = await getLabeler();
const ctx = await toVehicleContext(sel);
const live = await getIssueData('live');
const groups = groupForDisplay(live.issues, ctx);

const genLabel = generationLabel(generation);
const engineGroup = engineGroupIdentity(engine, variant);
const engineTitle = engineGroup.label;
const title = `${brand.name} ${model.name} ${engineTitle}`;
const subtitle = generation.kind === 'unassigned' ? 'Kasa bilgisi yok' : genLabel;
const back = withBase(catalogPath({ brand: brand.slug, model: model.slug, engine: engineGroup.slug }));
const pathFor = (revSlug: string | undefined, variantSlug: string) =>
  vehiclePath({ brand: brand.slug, model: model.slug, generation: generation.slug, revision: revSlug, variant: variantSlug });

// Aynı motorun diğer makyaj dönemleri ve aynı dönemdeki diğer motorlar (yeniden seçim gerektirmeden geçiş).
const otherRevisions = revisionsForVariant(generation, variant).filter((r) => r && r.id !== revision?.id);
const siblings = generation.variants
  .filter((v) => v.id !== variant.id && isTurkeyPrimary(v) && revisionsForVariant(generation, v).some((r) => r?.id === revision?.id))
  .map((v) => ({ v, e: catalog.engineById.get(v.engineId)! }))
  .sort((a, b) => a.e.name.localeCompare(b.e.name, 'tr', { numeric: true }));

/** Sayfa bölümleri. Yeni bölüm: bileşenini ekleyin ve buraya bir satır yazın. */
const SECTIONS = [
  { id: 'kimlik', title: 'Araç' },
  { id: 'motor', title: 'Motor' },
  { id: 'kronik-sorunlar', title: 'Bilinen sorunlar' },
];

const description = `${brand.name} ${model.name} ${engineTitle}: motor ve kasa özeti.`;
const outsideMainCatalog = brandTier(brand.slug) !== 'primary' || isHiddenModel(brand.slug, model.slug);
---

<SiteLayout title={`${title} ${subtitle}`} description={description}>
  <article class="vehicle">
    <nav class="vehicle-crumbs" aria-label="Konum">
      <a href={back}>← Katalogda bu seçime dön</a>
      <span aria-hidden="true">·</span>
      <span>{brand.name} › {model.name} › {engineGroup.label} › {generation.kind === 'unassigned' ? 'Kasa bilgisi yok' : genLabel}</span>
    </nav>

    {outsideMainCatalog && <p class="callout-info">Bu araç Türkiye ana kataloğunda yer almıyor.</p>}

    <header class="vehicle-head" id="kimlik">
      <div>
        <h1>{title}</h1>
        <p class="vehicle-sub">{subtitle}</p>
      </div>
      <div class="media-placeholder" role="img" aria-label="Araç görseli henüz eklenmedi">
        <span aria-hidden="true" class="media-icon"></span>
        <span>Görsel yakında</span>
      </div>
    </header>

    <nav class="vehicle-toc" aria-label="Bu sayfada">
      <ul>
        {SECTIONS.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      </ul>
    </nav>

    <section class="vehicle-section" aria-labelledby="kimlik-baslik">
      <h2 id="kimlik-baslik">Araç</h2>
      <dl class="spec-grid">
        <div><dt>Marka</dt><dd>{brand.name}</dd></div>
        <div><dt>Model</dt><dd>{model.name}</dd></div>
        <div><dt>Motor</dt><dd>{engineTitle}</dd></div>
        {
          generation.kind === 'unassigned' ? (
            <div><dt>Kasa</dt><dd>Kasa bilgisi yok</dd></div>
          ) : (
            <>
              <div><dt>Kasa</dt><dd>{generation.code ? `${genLabel} · ${generation.code}` : genLabel}</dd></div>
              <div><dt>Yıllar</dt><dd>{formatYearRange(generation.labelPeriod)}</dd></div>
            </>
          )
        }
      </dl>

      {
        (otherRevisions.length > 0 || siblings.length > 0) && (
          <div class="vehicle-switch">
            {otherRevisions.length > 0 && (
              <p>
                <span class="issue-key">{revision ? 'Aynı motor, diğer dönem:' : 'Makyaj dönemi doğrulanmadı:'}</span>{' '}
                {otherRevisions.map((r, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={pathFor(r!.slug, variant.slug)}>{r!.name}</a>
                  </>
                ))}
              </p>
            )}
            {siblings.length > 0 && (
              <details>
                <summary>{revision ? `${revision.name} dönemdeki` : 'Bu nesildeki'} diğer motorlar ({siblings.length})</summary>
                <ul class="plain sibling-list">
                  {siblings.map(({ v, e }) => {
                    const badge = performanceBadge(v);
                    return (
                      <li>
                        <a href={pathFor(revision?.slug, v.slug)}>
                          {e.name}
                          {badge && !e.name.includes(badge) && ` (${badge})`}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            )}
          </div>
        )
      }
    </section>

    <EngineSpecs engine={engine} variant={variant} />

    <IssuesSection
      groups={groups}
      sourceById={live.sourceById}
      label={label}
      engineMappingUncertain={!revisionMappingVerified}
    />
  </article>
</SiteLayout>
